#
# Copy to ~/values-secret-aiq.yaml and put real values there.
# Do not commit the copy. load-secrets prefers ~/values-secret-aiq.yaml
# over this template.
#
# Field names must match keys in Secret aiq-credentials (envFrom on the pods).
# load-secrets writes Vault KV at secret/data/hub/<secret name>. ESO copies
# those keys into a Kubernetes Secret of the same name. Prefix hub is the
# ansible vault_hub default. Do not set vaultPrefixes on entries.
#
# Leave DB_USER_PASSWORD unset in your copy so Vault generates it once.
# Re-run load-secrets must not rotate Postgres, so override stays omitted.
#
# Optional keys not listed here (omit from your copy unless you need them):
#   VLLM_API_KEY — in-cluster vLLM placeholder (set to local-vllm if omitted from env)
#   AIQ_LIGHTNING_BASE_URL — override in-cluster vLLM base URL (KServe predictor
#     Service listens on port 80, not 8080; omit unless you need a custom URL)
#
# Install: ./pattern.sh make install (waits for Vault, then load-secrets).

version: "2.0"
backingStore: vault
vaultPolicies:
  dbPassword: |
    length=16
    rule "charset" { charset = "abcdefghijklmnopqrstuvwxyz" min-chars = 1 }
    rule "charset" { charset = "ABCDEFGHIJKLMNOPQRSTUVWXYZ" min-chars = 1 }
    rule "charset" { charset = "0123456789" min-chars = 1 }
secrets:
  - name: rustfs-admin
    fields:
      - name: RUSTFS_ACCESS_KEY
        value: aiq-store-admin
      - name: RUSTFS_SECRET_KEY
        onMissingValue: generate
        vaultPolicy: dbPassword
  - name: model-publisher
    fields:
      - name: AWS_ACCESS_KEY_ID
        value: aiq-model-publisher
      - name: AWS_SECRET_ACCESS_KEY
        onMissingValue: generate
        vaultPolicy: dbPassword
  - name: model-reader
    fields:
      - name: AWS_ACCESS_KEY_ID
        value: aiq-model-reader
      - name: AWS_SECRET_ACCESS_KEY
        onMissingValue: generate
        vaultPolicy: dbPassword
  - name: aiq-credentials
    fields:
      - name: DB_USER_NAME
        value: aiq
      - name: DB_USER_PASSWORD
        onMissingValue: generate
        vaultPolicy: dbPassword
      - name: TAVILY_API_KEY
        value: "Tavily key, or empty for install-only smoke tests"
      - name: NVIDIA_API_KEY
        value: "Required: Nemotron 3 Ultra on NVIDIA API Catalog (clarifier + deep research)"
      - name: VLLM_API_KEY
        value: "local-vllm"
  - name: huggingface-secret
    fields:
      - name: hftoken
        value: null
